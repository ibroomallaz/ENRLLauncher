<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Official UA Brand Core Colors -->
    <Color x:Key="Color.UA.Navy">#0C2340</Color>
    <Color x:Key="Color.UA.Red">#AB0520</Color>
    <Color x:Key="Color.UA.Oasis">#378DBD</Color>
    <Color x:Key="Color.UA.Sky">#81D3EB</Color>
    <Color x:Key="Color.UA.Chili">#8B0015</Color>

    <!-- UI Background & Surface Tokens -->
    <Color x:Key="Color.Window.Background">#0B132B</Color>
    <Color x:Key="Color.Surface.Primary">#0C2340</Color>
    <Color x:Key="Color.Surface.Secondary">#162B4D</Color>
    <Color x:Key="Color.Surface.Tertiary">#1E3A5F</Color>
    <Color x:Key="Color.Surface.Hover">#284B75</Color>

    <!-- State & Accent Tokens -->
    <Color x:Key="Color.Accent">#AB0520</Color>
    <Color x:Key="Color.Accent.Hover">#D32F2F</Color>
    <Color x:Key="Color.Accent.Secondary">#378DBD</Color>
    <Color x:Key="Color.Success">#4CAF50</Color>
    <Color x:Key="Color.Danger">#E53935</Color>
    <Color x:Key="Color.Border">#1E3A5F</Color>
    <Color x:Key="Color.Border.Light">#284B75</Color>

    <!-- Typography Tokens -->
    <Color x:Key="Color.Text.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Text.Secondary">#B0BEC5</Color>
    <Color x:Key="Color.Text.Muted">#78909C</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>

    <!-- Core UA Brushes -->
    <SolidColorBrush x:Key="Brush.UA.Navy" Color="{StaticResource Color.UA.Navy}"/>
    <SolidColorBrush x:Key="Brush.UA.Red" Color="{StaticResource Color.UA.Red}"/>
    <SolidColorBrush x:Key="Brush.UA.Oasis" Color="{StaticResource Color.UA.Oasis}"/>
    <SolidColorBrush x:Key="Brush.UA.Sky" Color="{StaticResource Color.UA.Sky}"/>
    <SolidColorBrush x:Key="Brush.UA.Chili" Color="{StaticResource Color.UA.Chili}"/>

    <!-- Semantic UI Surface Brushes -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface.Primary" Color="{StaticResource Color.Surface.Primary}"/>
    <SolidColorBrush x:Key="Brush.Surface.Secondary" Color="{StaticResource Color.Surface.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Surface.Tertiary" Color="{StaticResource Color.Surface.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}"/>

    <!-- Semantic Action & Accent Brushes -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Secondary" Color="{StaticResource Color.Accent.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Border.Light" Color="{StaticResource Color.Border.Light}"/>

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}"/>
</ResourceDictionary>