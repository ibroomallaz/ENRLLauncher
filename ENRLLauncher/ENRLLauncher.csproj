<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Title>Arizona Admissions Launcher</Title>
    <Version>0.0.1-Alpha</Version>
    <PackageProjectUrl>https://github.com/ibroomallaz/ENRLLauncher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ibroomallaz/ENRLLauncher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyVersion>0.0.1001</AssemblyVersion>
    <FileVersion>0.0.1001</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\img\ualogo.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\img\ualogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
