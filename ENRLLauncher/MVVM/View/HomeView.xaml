<UserControl x:Class="ENRLLauncher.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1100"
             PreviewMouseLeftButtonDown="HomeView_PreviewMouseLeftButtonDown"
             PreviewMouseMove="HomeView_PreviewMouseMove"
             PreviewMouseLeftButtonUp="HomeView_PreviewMouseLeftButtonUp">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Edit Mode Banner -->
        <Border Grid.Row="0" 
                HorizontalAlignment="Center" 
                Margin="0,0,0,16" 
                Padding="16,6" 
                Background="#9A3412" 
                BorderBrush="#EA580C" 
                BorderThickness="1" 
                CornerRadius="16"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✏ EDIT MODE ACTIVE" 
                           Foreground="#FFFFFF" 
                           FontWeight="Bold" 
                           FontSize="12" 
                           Margin="0,0,8,0"/>
                <TextBlock Text="— Drag cards to swap positions, click ✕ to delete" 
                           Foreground="#FED7AA" 
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" MaxWidth="1200">

                <!-- Dynamic Launch Cards -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="215" Height="150" Margin="12" 
                                    CornerRadius="12" 
                                    Padding="14"
                                    Tag="CardBorder">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#152744"/>
                                        <Setter Property="BorderBrush" Value="#2B4D7E"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#475569"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#142136"/>
                                                <Setter Property="Cursor" Value="SizeAll"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <!-- Launch Card Content -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.LaunchItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Cursor" Value="SizeAll"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Background="#1E3A5F" CornerRadius="6" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TargetType}" Foreground="#38BDF8" 
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" 
                                                       FontWeight="Bold" FontSize="14" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#94A3B8" 
                                                       FontSize="11" TextAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete Button (Top-Right) -->
                                    <Button Content="✕" 
                                            Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                                            Background="#EF4444" 
                                            Foreground="#FFFFFF" 
                                            FontWeight="Black" 
                                            FontSize="11"
                                            Width="24" Height="24" 
                                            BorderThickness="0" 
                                            Cursor="Hand"
                                            Margin="0,-6,-6,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="12"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Drag-and-Drop / File Picker Ingestion Card -->
                <Border Width="215" Height="150" Margin="12" 
        CornerRadius="12" 
        AllowDrop="True" 
        Drop="DropZone_Drop" 
        DragOver="DropZone_DragOver"
        Visibility="{Binding IsDropCardVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#101F35"/>
                            <Setter Property="BorderBrush" Value="#294C7A"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="Background" Value="#142136"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Button Background="Transparent" 
            BorderThickness="0" 
            Cursor="Hand"
            Command="{Binding OpenFilePickerCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="36" FontWeight="Light" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add / Drop File" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>