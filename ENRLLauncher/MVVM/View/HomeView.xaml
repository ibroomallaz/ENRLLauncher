<UserControl x:Class="ENRLLauncher.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:enums="clr-namespace:ENRLLauncher.Core.Enums"
             xmlns:controls="clr-namespace:ENRLLauncher.MVVM.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1100"
             PreviewMouseLeftButtonDown="HomeView_PreviewMouseLeftButtonDown"
             PreviewMouseMove="HomeView_PreviewMouseMove"
             PreviewMouseLeftButtonUp="HomeView_PreviewMouseLeftButtonUp">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 1. Reusable Edit Mode Toolbar Pill Button -->
        <Style x:Key="EditModeToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Reusable Circular Delete Badge -->
        <Style x:Key="CardDeleteButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
            <Setter Property="Command" Value="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Launch Card Outer Border Style -->
        <Style x:Key="LaunchCardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="BorderBrush" Value="#475569"/>
                    <Setter Property="Background" Value="#142136"/>
                    <Setter Property="Cursor" Value="SizeAll"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 4. Launch Card Click Button Style -->
        <Style x:Key="CardLaunchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding DataContext.LaunchItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Cursor" Value="SizeAll"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 5. Explorer Drop Target Border Style -->
        <Style x:Key="DropZoneCardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Light}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Edit Mode Divider Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Tiles & In-Grid Dividers Workspace -->
        </Grid.RowDefinitions>

        <!-- 1. EDIT MODE ACTION BAR -->
        <Border Grid.Row="0" 
                HorizontalAlignment="Center" 
                Margin="0,0,0,16" 
                Padding="16,6" 
                Background="#9A3412" 
                BorderBrush="#EA580C" 
                BorderThickness="1" 
                CornerRadius="16"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✏ EDIT MODE" 
                           Foreground="#FFFFFF" 
                           FontWeight="Bold" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0"/>

                <!-- Full Horizontal Row Break -->
                <Button Content="+ Row Break" 
                        Command="{Binding AddHorizontalSeparatorCommand}"
                        Style="{StaticResource EditModeToolbarButtonStyle}"
                        Margin="0,0,6,0"/>

                <!-- Long Vertical Divider -->
                <Button Content="+ Long Vertical" 
                        Command="{Binding AddLongVerticalSeparatorCommand}"
                        Style="{StaticResource EditModeToolbarButtonStyle}"
                        Margin="0,0,6,0"/>

                <!-- Short Vertical Divider -->
                <Button Content="+ Short Vertical" 
                        Command="{Binding AddShortVerticalSeparatorCommand}"
                        Style="{StaticResource EditModeToolbarButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- 2. WORKSPACE GRID -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,20">

                <!-- Dynamic Centered Launch Cards & In-Grid Separators -->
                <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteredWrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- A. STANDARD LAUNCH CARD -->
                                <Border x:Name="CardTile" 
                                        Tag="CardBorder"
                                        Style="{StaticResource LaunchCardBorderStyle}">
                                    <Grid>
                                        <Button Style="{StaticResource CardLaunchButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Brush.Surface.Tertiary}" CornerRadius="4" Padding="8,3" Margin="0,0,0,8" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding TargetType}" Foreground="{DynamicResource Brush.UA.Oasis}" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete Badge Overlay -->
                                        <Button Style="{StaticResource CardDeleteButtonStyle}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                Margin="0,-4,-4,0"/>
                                    </Grid>
                                </Border>

                                <!-- B. FULL HORIZONTAL ROW BREAK WITH CENTERED EDITABLE LABEL -->
                                <Border x:Name="HorizontalDivider"
                                        Tag="CardBorder"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                                        Height="46"
                                        Margin="0,10"
                                        Background="Transparent"
                                        Visibility="Collapsed">
                                    <Grid VerticalAlignment="Center" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Symmetrical Line -->
                                        <Rectangle Grid.Column="0" Style="{DynamicResource FullHorizontalSeparator}"/>

                                        <!-- Center Title & Delete Button Container -->
                                        <StackPanel Grid.Column="1" 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Center" 
                                                    HorizontalAlignment="Center" 
                                                    Margin="16,0">
                                            <!-- Read Mode Header -->
                                            <TextBlock Text="{Binding Title}" 
                                                       Foreground="{DynamicResource Brush.Text.Primary}" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Edit Mode Input Box -->
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="SectionTitle_LostFocus"
                                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                                     Background="#1E293B"
                                                     BorderBrush="{DynamicResource Brush.UA.Sky}"
                                                     BorderThickness="1"
                                                     Padding="12,3"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     TextAlignment="Center"
                                                     MinWidth="150"
                                                     VerticalAlignment="Center">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </TextBox.Resources>
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <!-- Delete Badge -->
                                            <Button Style="{StaticResource CardDeleteButtonStyle}"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <!-- Right Symmetrical Line -->
                                        <Rectangle Grid.Column="2" Style="{DynamicResource FullHorizontalSeparator}"/>
                                    </Grid>
                                </Border>

                                <!-- C. LONG VERTICAL DIVIDER (Card Height) -->
                                <Border x:Name="LongVerticalDivider"
                                        Tag="CardBorder"
                                        Width="36" Height="150"
                                        Margin="6,10"
                                        Background="Transparent"
                                        Visibility="Collapsed">
                                    <Grid HorizontalAlignment="Center">
                                        <Rectangle Style="{DynamicResource LongVerticalSeparator}" Height="120" VerticalAlignment="Center"/>

                                        <Button Style="{StaticResource CardDeleteButtonStyle}"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" 
                                                Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- D. SHORT VERTICAL DIVIDER (Centered Notch) -->
                                <Border x:Name="ShortVerticalDivider"
                                        Tag="CardBorder"
                                        Width="32" Height="150"
                                        Margin="4,10"
                                        Background="Transparent"
                                        Visibility="Collapsed">
                                    <Grid HorizontalAlignment="Center">
                                        <Rectangle Style="{DynamicResource ShortVerticalSeparator}"/>

                                        <Button Style="{StaticResource CardDeleteButtonStyle}"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" 
                                                Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- DataTemplate Triggers -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding TargetType}" Value="{x:Static enums:LaunchTargetType.HorizontalSeparator}">
                                    <Setter TargetName="CardTile" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="HorizontalDivider" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TargetType}" Value="{x:Static enums:LaunchTargetType.LongVerticalSeparator}">
                                    <Setter TargetName="CardTile" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="LongVerticalDivider" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TargetType}" Value="{x:Static enums:LaunchTargetType.ShortVerticalSeparator}">
                                    <Setter TargetName="CardTile" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ShortVerticalDivider" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. EXPLORER DROP / FILE PICKER TILE -->
                <Border Style="{StaticResource DropZoneCardBorderStyle}"
                        HorizontalAlignment="Center"
                        AllowDrop="True" 
                        Drop="DropZone_Drop" 
                        DragOver="DropZone_DragOver"
                        Visibility="{Binding IsDropCardVisible, Converter={StaticResource BoolToVis}}">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding OpenFilePickerCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="32" Foreground="{DynamicResource Brush.UA.Sky}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add / Drop File" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>