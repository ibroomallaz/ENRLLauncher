<Window x:Class="ENRLLauncher.MVVM.View.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="560" Height="320"
        ShowActivated="False"
        Focusable="False">
    <Border CornerRadius="16" 
            Background="#0B132B" 
            BorderThickness="1" 
            BorderBrush="#294C7A" 
            Padding="24" 
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- centered logo/title -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,24">
                <Border Width="52" Height="52" CornerRadius="26" 
                        Background="#142744" 
                        BorderBrush="#203E63" 
                        BorderThickness="1" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,16">
                    <Image Source="/Assets/img/ualogo.png" 
                           Width="38" Height="38" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Arizona Admissions Launcher" Foreground="#E6E6E6" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="University of Arizona" Foreground="#81D3EB" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- bottom status row centered as a unit -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" IsIndeterminate="True" Height="6" Width="200"/>
                <TextBlock Grid.Column="2" x:Name="StatusText" Text="Starting…" Foreground="#A0A6B2" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
