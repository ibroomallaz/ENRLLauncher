<UserControl x:Class="ENRLLauncher.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Settings &amp; Configuration" 
                   FontSize="18" FontWeight="Bold" 
                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Application Preferences & Save Action -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Primary}" 
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                    CornerRadius="10" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Startup &amp; Behavior" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.UA.Sky}" FontSize="15" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1">
                        <!-- Start in Fullscreen -->
                        <Border Background="{DynamicResource Brush.Surface.Secondary}" 
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="Start in Fullscreen mode" 
                                          IsChecked="{Binding StartInFullScreen}"
                                          Foreground="{DynamicResource Brush.Text.Primary}" 
                                          FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Opens the application directly into borderless presentation kiosk mode." 
                                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                           Margin="20,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Launch on Windows Startup -->
                        <Border Background="{DynamicResource Brush.Surface.Secondary}" 
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="Launch app on Windows startup" 
                                          IsChecked="{Binding LaunchOnWindowsStartup}"
                                          Foreground="{DynamicResource Brush.Text.Primary}" 
                                          FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Automatically starts the Arizona Admissions Launcher when logging into Windows." 
                                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                           Margin="20,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Edit Mode PIN Protection -->
                        <Border Background="{DynamicResource Brush.Surface.Secondary}" 
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="Require PIN for Edit Mode" 
                                          IsChecked="{Binding RequirePinForEditMode}"
                                          Foreground="{DynamicResource Brush.Text.Primary}" 
                                          FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Prevents unauthorized modifications to shortcut tiles and layouts without entering a PIN or Windows Administrator authorization." 
                                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                           Margin="20,4,0,0" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="20,10,0,0"
                                            Visibility="{Binding RequirePinForEditMode, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Change PIN…" 
                                            Command="{Binding ChangePinCommand}"
                                            Background="{DynamicResource Brush.Surface.Tertiary}"
                                            Foreground="{DynamicResource Brush.Text.Primary}"
                                            Padding="12,5" FontSize="11" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Save Action Section -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                            CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Status:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11"/>
                                <TextBlock Text="{Binding StatusMessage}" 
                                           Foreground="{DynamicResource Brush.Text.Primary}" 
                                           FontWeight="SemiBold" FontSize="12" 
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Save Changes" 
                                    Command="{Binding SaveSettingsCommand}" 
                                    Padding="18,8" 
                                    Background="{DynamicResource Brush.Success}" 
                                    Foreground="{DynamicResource Brush.Text.OnAccent}" 
                                    FontWeight="Bold" FontSize="12"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: Backup & Storage Controls -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Primary}" 
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                    CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Backup &amp; Data Management" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.UA.Sky}" FontSize="15" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Layout Backup Section -->
                            <Border Background="{DynamicResource Brush.Surface.Secondary}" 
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                    CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Layout Configuration" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13"/>
                                    <TextBlock Text="Export your shortcut buttons and layout to a JSON file or restore from a previous backup." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,2,0,12"/>

                                    <WrapPanel>
                                        <Button Content="Backup Layout to File…" 
                                                Command="{Binding ExportLayoutCommand}" 
                                                Background="{DynamicResource Brush.Surface.Tertiary}" 
                                                Foreground="{DynamicResource Brush.Text.Primary}" 
                                                Padding="12,6" Margin="0,0,8,8" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Restore Layout from File…" 
                                                Command="{Binding ImportLayoutCommand}" 
                                                Background="{DynamicResource Brush.Surface.Tertiary}" 
                                                Foreground="{DynamicResource Brush.Text.Primary}" 
                                                Padding="12,6" Margin="0,0,8,8" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Restore from Auto-Backup (.bak)" 
                                                Command="{Binding RestoreAutoBackupCommand}" 
                                                Background="{DynamicResource Brush.Surface.Tertiary}" 
                                                Foreground="{DynamicResource Brush.Text.Primary}" 
                                                Padding="12,6" Margin="0,0,8,8" BorderThickness="0" Cursor="Hand"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Storage Directories Section -->
                            <Border Background="{DynamicResource Brush.Surface.Secondary}" 
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                    CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="System &amp; Storage Locations" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13"/>
                                    <TextBlock Text="Open local application folders in Windows Explorer for diagnostics, logs, or manual inspection." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,2,0,12"/>

                                    <WrapPanel>
                                        <Button Content="Open Data Directory" 
                                                Command="{Binding OpenAppDataFolderCommand}" 
                                                Background="{DynamicResource Brush.Surface.Tertiary}" 
                                                Foreground="{DynamicResource Brush.Text.Primary}" 
                                                Padding="12,6" Margin="0,0,8,8" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Open Logs Directory" 
                                                Command="{Binding OpenLogsFolderCommand}" 
                                                Background="{DynamicResource Brush.Surface.Tertiary}" 
                                                Foreground="{DynamicResource Brush.Text.Primary}" 
                                                Padding="12,6" Margin="0,0,8,8" BorderThickness="0" Cursor="Hand"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Backup Status Feedback Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                            CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <TextBlock Text="{Binding BackupStatusMessage, FallbackValue='Ready'}" 
                                   Foreground="{DynamicResource Brush.UA.Sky}" 
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
