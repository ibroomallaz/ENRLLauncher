<UserControl x:Class="ENRLLauncher.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ENRLLauncher.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Settings &amp; Configuration" 
                   FontSize="18" FontWeight="Bold" 
                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Application Preferences & Save Action -->
            <Border Grid.Column="0" Style="{StaticResource SettingsPaneCardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Startup &amp; Behavior" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.UA.Sky}" FontSize="15" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Start in Fullscreen -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="Start in Fullscreen mode" 
                                              IsChecked="{Binding StartInFullScreen}"
                                              Foreground="{DynamicResource Brush.Text.Primary}" 
                                              FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Opens the application directly into borderless presentation kiosk mode." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                               Margin="20,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Launch on Windows Startup -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="Launch app on Windows startup" 
                                              IsChecked="{Binding LaunchOnWindowsStartup}"
                                              Foreground="{DynamicResource Brush.Text.Primary}" 
                                              FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Automatically starts the Arizona Admissions Launcher when logging into Windows." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                               Margin="20,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Edit Mode PIN Protection -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="Require PIN for Edit Mode" 
                                              IsChecked="{Binding RequirePinForEditMode}"
                                              Foreground="{DynamicResource Brush.Text.Primary}" 
                                              FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Prevents unauthorized modifications to shortcut tiles and layouts without entering a PIN or Windows Administrator authorization." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                               Margin="20,4,0,0" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="20,10,0,0"
                                                Visibility="{Binding RequirePinForEditMode, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Change PIN&#x2026;" 
                                                Command="{Binding ChangePinCommand}"
                                                Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Logging Level Selection -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Logging Level" 
                                               Foreground="{DynamicResource Brush.Text.Primary}" 
                                               FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Controls the minimum severity of diagnostic events recorded to the log file." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                               Margin="0,4,0,10" TextWrapping="Wrap"/>

                                    <ComboBox ItemsSource="{Binding AvailableLogLevels}" 
                                              SelectedItem="{Binding SelectedLogLevel}" 
                                              Style="{StaticResource DarkComboBoxStyle}"/>

                                    <TextBlock Text="{Binding LogLevelDescription}" 
                                               Foreground="{DynamicResource Brush.UA.Sky}" FontSize="11" 
                                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save Action Section -->
                    <Border Grid.Row="2" Style="{StaticResource SettingSectionCardStyle}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Status:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11"/>
                                <TextBlock Text="{Binding StatusMessage}" 
                                           Foreground="{DynamicResource Brush.Text.Primary}" 
                                           FontWeight="SemiBold" FontSize="12" 
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Save Changes" 
                                    Command="{Binding SaveSettingsCommand}" 
                                    Style="{StaticResource SuccessActionButtonStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: Updates, About & Storage Controls -->
            <Border Grid.Column="1" Style="{StaticResource SettingsPaneCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="System, Updates &amp; Data" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.UA.Sky}" FontSize="15" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Software Updates Section -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <!-- Header Row with Status Badge -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Software Updates" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13"/>
                                            <TextBlock Text="Check for application updates and keep the launcher current." 
                                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Status Badge Indicator -->
                                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="8,3" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Default state: Up to date -->
                                                    <Setter Property="Background" Value="#132742"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                            <Setter Property="Background" Value="#2B1320"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.UA.Red}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCheckingForUpdates}" Value="True">
                                                            <Setter Property="Background" Value="#102035"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.UA.Sky}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCheckingForUpdates}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.UA.Sky}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Up to date"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                    <Setter Property="Text" Value="Update Available"/>
                                                                    <Setter Property="Foreground" Value="#FCA5A5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCheckingForUpdates}" Value="True">
                                                                    <Setter Property="Text" Value="Checking&#x2026;"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.UA.Sky}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Current Version & Status Info -->
                                    <Border Style="{StaticResource SettingInfoCardStyle}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Current Version -->
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock Text="Installed Version" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding AppVersionDisplay}" Foreground="{DynamicResource Brush.Text.Primary}" 
                                                           FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Update Status Message -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Status" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="{DynamicResource Brush.UA.Sky}" 
                                                           FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Last Checked Timestamp -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LastCheckedMessage}" Foreground="{DynamicResource Brush.Text.Muted}" 
                                                           FontSize="11" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Progress bar while checking -->
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                                                 Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}"
                                                 Background="{DynamicResource Brush.Surface.Tertiary}"
                                                 Foreground="{DynamicResource Brush.UA.Sky}"/>

                                    <!-- Action Buttons -->
                                    <WrapPanel>
                                        <Button Content="Check for Updates" 
                                                Command="{Binding CheckForUpdatesCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,8,0"/>

                                        <Button Content="{Binding UpdateButtonLabel, FallbackValue='Install Update'}" 
                                                Command="{Binding InstallUpdateCommand}" 
                                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource DangerActionButtonStyle}"
                                                Margin="0,0,8,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- About Section -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <!-- App Header with Logo -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" 
                                                Background="{DynamicResource Brush.Surface.Tertiary}" 
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Image Source="/Assets/img/ualogo.png" Width="34" Height="34" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppName}" FontWeight="Bold" 
                                                       Foreground="{DynamicResource Brush.Text.Primary}" FontSize="14"/>
                                            <TextBlock Text="University of Arizona &#x2022; Enrollment Management" 
                                                       Foreground="{DynamicResource Brush.UA.Sky}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Version & Developer Specifications Grid -->
                                    <Border Style="{StaticResource SettingInfoCardStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Application Version" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding AppVersionDisplay}" Foreground="{DynamicResource Brush.Text.Primary}" 
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="Build Version" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding FileVersionDisplay}" Foreground="{DynamicResource Brush.Text.Primary}" 
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Developer" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding DeveloperName}" Foreground="{DynamicResource Brush.UA.Sky}" 
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Footer Actions and Developer Credit -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="GitHub Repository" 
                                                Command="{Binding OpenGitHubCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding DeveloperCredit}" 
                                                   Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Layout Backup Section -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Layout Configuration" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13"/>
                                    <TextBlock Text="Export your shortcut buttons and layout to a JSON file or restore from a previous backup." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,2,0,12"/>

                                    <WrapPanel>
                                        <Button Content="Backup Layout to File&#x2026;" 
                                                Command="{Binding ExportLayoutCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Restore Layout from File&#x2026;" 
                                                Command="{Binding ImportLayoutCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Restore from Auto-Backup (.bak)" 
                                                Command="{Binding RestoreAutoBackupCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Storage Directories Section -->
                            <Border Style="{StaticResource SettingSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="System &amp; Storage Locations" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13"/>
                                    <TextBlock Text="Open local application folders in Windows Explorer for diagnostics, logs, or manual inspection." 
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,2,0,12"/>

                                    <WrapPanel>
                                        <Button Content="Open Data Directory" 
                                                Command="{Binding OpenAppDataFolderCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Open Logs Directory" 
                                                Command="{Binding OpenLogsFolderCommand}" 
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Backup Status Feedback Bar -->
                    <Border Grid.Row="2" Style="{StaticResource SettingSectionCardStyle}" 
                            Padding="12" Margin="0,10,0,0">
                        <TextBlock Text="{Binding BackupStatusMessage, FallbackValue='Ready'}" 
                                   Foreground="{DynamicResource Brush.UA.Sky}" 
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
