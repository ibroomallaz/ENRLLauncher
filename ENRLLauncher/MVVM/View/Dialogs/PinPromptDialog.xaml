<Window x:Class="ENRLLauncher.MVVM.View.Dialogs.PinPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:ENRLLauncher.MVVM.ViewModel.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance dialogs:PinPromptDialogViewModel}"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="OnWindowLoaded"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- PasswordBox Custom Compact Style -->
        <Style x:Key="CompactPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#162B4D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#81D3EB"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="#0B132B"
            BorderBrush="#1E3A5F"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Compact Drag Header -->
            <Border Grid.Row="0" Padding="10,6"
                    Background="#0C2340"
                    BorderBrush="#1E3A5F"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TitleText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="18" Height="18" Padding="0"
                            Command="{Binding CloseCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            FontSize="10"
                            BorderBrush="{x:Null}"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Popup Body -->
            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Feedback / Errors -->
                    <RowDefinition Height="Auto"/>
                    <!-- Modes Content -->
                </Grid.RowDefinitions>

                <!-- Feedback Area -->
                <StackPanel Grid.Row="0">
                    <!-- Error Message -->
                    <Border Background="#2B1320"
                            BorderBrush="#EF4444"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,3"
                            Margin="0,0,0,6"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FCA5A5"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Busy State -->
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                        <TextBlock Text="{Binding BusyMessage}"
                                   Foreground="#81D3EB"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>
                        <ProgressBar IsIndeterminate="True" Height="2" Background="#0C2340" Foreground="#378DBD"/>
                    </StackPanel>
                </StackPanel>

                <!-- Mode A: Verify PIN Mode -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsVerifyMode, Converter={StaticResource BoolToVis}}">
                    <PasswordBox x:Name="VerifyPinBox"
                                 Style="{StaticResource CompactPasswordBoxStyle}"
                                 Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Height="26"
                                Command="{Binding CloseCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="11"
                                Background="#162B4D" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Unlock"
                                Height="26"
                                Click="OnSubmitVerifyClick"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="11"
                                Background="#AB0520" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <!-- Admin Override Link -->
                    <Button Click="OnAdminOverrideClick"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="{Binding IsNotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Forgot PIN? Windows Admin"
                                       Foreground="#81D3EB" FontSize="10" TextDecorations="Underline" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Mode B: Setup PIN Mode -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="New PIN (min 4 digits):" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="SetupPinBox"
                                 Style="{StaticResource CompactPasswordBoxStyle}"
                                 Margin="0,0,0,6"/>

                    <TextBlock Text="Confirm PIN:" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="SetupConfirmPinBox"
                                 Style="{StaticResource CompactPasswordBoxStyle}"
                                 Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Height="26"
                                Command="{Binding CloseCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="11"
                                Background="#162B4D" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Save"
                                Height="26"
                                Click="OnSubmitSetupClick"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="11"
                                Background="#378DBD" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </StackPanel>

                <!-- Mode C: Change PIN Mode -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsChangeMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Current PIN:" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="ChangeCurrentPinBox"
                                 Style="{StaticResource CompactPasswordBoxStyle}"
                                 Margin="0,0,0,6"/>

                    <TextBlock Text="New PIN (min 4 digits):" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="ChangeNewPinBox"
                                 Style="{StaticResource CompactPasswordBoxStyle}"
                                 Margin="0,0,0,6"/>

                    <TextBlock Text="Confirm PIN:" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="ChangeConfirmPinBox"
                                 Style="{StaticResource CompactPasswordBoxStyle}"
                                 Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Height="26"
                                Command="{Binding CloseCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="11"
                                Background="#162B4D" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Update"
                                Height="26"
                                Click="OnSubmitChangeClick"
                                IsEnabled="{Binding IsNotBusy}"
                                FontSize="11"
                                Background="#378DBD" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <Button Click="OnAdminOverrideClick"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="{Binding IsNotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Forgot current PIN? Windows Admin"
                                       Foreground="#81D3EB" FontSize="10" TextDecorations="Underline" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Mode D: Admin Verified Actions Mode -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsAdminVerifiedMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Admin verified. Select action:"
                               Foreground="#CBD5E1" FontSize="10" Margin="0,0,0,6" HorizontalAlignment="Center"/>

                    <Button Content="Unlock for this session"
                            Height="26" Margin="0,0,0,4"
                            Command="{Binding AdminUnlockOnlyCommand}"
                            FontSize="11"
                            Background="#AB0520" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="Remove &amp; Disable PIN"
                            Height="26" Margin="0,0,0,4"
                            Command="{Binding AdminDisablePinCommand}"
                            FontSize="11"
                            Background="#1E3A5F" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="Set New PIN"
                            Height="26" Margin="0,0,0,4"
                            Command="{Binding AdminSetNewPinCommand}"
                            FontSize="11"
                            Background="#162B4D" Foreground="#81D3EB" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="Cancel"
                            Height="24"
                            Command="{Binding CloseCommand}"
                            FontSize="10"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
