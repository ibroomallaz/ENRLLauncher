<Window x:Class="ENRLLauncher.MVVM.View.Dialogs.VersionUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="540"
        MaxWidth="600"
        MinHeight="320"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#0B132B"
            BorderBrush="#1E3A5F"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Drag Header -->
            <Border Grid.Row="0" Padding="16,10"
                    Background="#0C2340"
                    BorderBrush="#1E3A5F"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding TitleText}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="✕" Width="26" Height="26" Padding="0"
                            Command="{Binding CloseCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Background="Transparent"
                            Foreground="#B0BEC5"
                            BorderBrush="{x:Null}"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content Body -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="17"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding SubText}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#81D3EB"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Change Log"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Foreground="#B0BEC5"/>

                <Border Grid.Row="2"
                        Background="#162B4D"
                        BorderBrush="#1E3A5F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{Binding ChangeLogCardVisibility}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="180"
                                  CanContentScroll="True">
                        <TextBlock Text="{Binding ChangelogText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="#FFFFFF"
                                   FontSize="12"
                                   LineHeight="18"/>
                    </ScrollViewer>
                </Border>

                <!-- Admin Privileges Warning -->
                <Border Grid.Row="3" 
                        Margin="0,12,0,0"
                        Padding="10,8"
                        Background="#162B4D"
                        BorderBrush="#FFA726"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding AdminWarningVisibility}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠" Foreground="#FFA726" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Administrator privileges required for .NET Desktop Runtime upgrade." 
                                   Foreground="#FFFFFF" 
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Download Progress Indicator -->
                <StackPanel Grid.Row="4" Margin="0,12,0,0"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusText}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6" 
                               FontWeight="SemiBold"
                               Foreground="#81D3EB"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Background="#0C2340" Foreground="#AB0520"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Install Update"
                            MinWidth="110"
                            Height="32"
                            Margin="0,0,8,0"
                            Padding="12,4"
                            IsDefault="True"
                            Command="{Binding InstallUpdateCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Background="#AB0520"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="Release Notes"
                            MinWidth="110"
                            Height="32"
                            Margin="0,0,8,0"
                            Padding="12,4"
                            Command="{Binding OpenReleaseNotesCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Background="#1E3A5F"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="Close"
                            MinWidth="80"
                            Height="32"
                            Padding="12,4"
                            Command="{Binding CloseCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Background="#162B4D"
                            Foreground="#B0BEC5"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
