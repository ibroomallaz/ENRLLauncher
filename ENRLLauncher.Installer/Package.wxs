<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Arizona Admissions Launcher"
           Manufacturer="UArizona"
           Version="!(bind.fileVersion.ENRLLauncherExe)"
           UpgradeCode="B534BC6A-1E32-4735-9F1B-9477ED12A345"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Arizona Admissions Launcher is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\ENRLLauncher\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ibroomallaz/ENRLLauncher" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ibroomallaz/ENRLLauncher" />
    <Property Id="ARPCOMMENTS" Value="Arizona Admissions Launcher" />

    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Arizona Admissions Launcher" />
    <Property Id="WixShellExecTarget" Value="[!ENRLLauncherExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <util:CloseApplication Id="CloseENRLLauncher"
                           Target="ENRLLauncher.exe"
                           CloseMessage="yes"
                           Description="Arizona Admissions Launcher is currently running and must be closed to continue."
                           PromptToContinue="yes"
                           RebootPrompt="no" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <WixVariable Id="WixUIBannerBmp" Value="Resources\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Resources\dialog.bmp" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CompanyFolder" Name="UArizona">
        <Directory Id="ProductFolder" Name="ENRLLauncher">
          <Directory Id="INSTALLFOLDER" Name="App" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="UArizona Admissions" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="CmpENRLLauncherExe" Guid="A3D1E4A1-6571-4B9E-A2E7-347F9B1E62C1">
        <File Id="ENRLLauncherExe"
              Source="!(bindpath.ENRLLauncher)\ENRLLauncher.exe"
              KeyPath="yes" />
      </Component>

      <Files Include="!(bindpath.ENRLLauncher)\**">
        <Exclude Files="!(bindpath.ENRLLauncher)\ENRLLauncher.exe" />
        <Exclude Files="!(bindpath.ENRLLauncher)\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="ProductShortcuts">
      <Component Directory="ApplicationProgramsFolder" Id="AppShortcutsComponent" Guid="D2A6849F-2268-4C21-BD3C-4322DC2934D2">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Arizona Admissions Launcher"
                  Description="Arizona Admissions Launcher"
                  Target="[!ENRLLauncherExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />

        <Shortcut Id="ApplicationDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Arizona Admissions Launcher"
                  Description="Arizona Admissions Launcher"
                  Target="[!ENRLLauncherExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />

        <!-- Clean up per-user directories on uninstall -->
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveINSTALLFOLDER" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProductFolder" Directory="ProductFolder" On="uninstall" />
        <RemoveFolder Id="RemoveCompanyFolder" Directory="CompanyFolder" On="uninstall" />

        <!-- Registry tracking for per-user component KeyPath and cleanup on uninstall -->
        <RegistryKey Root="HKCU"
                     Key="Software\UArizona\ENRLLauncher"
                     ForceCreateOnInstall="yes"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Name="Installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Arizona Admissions Launcher" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ProductShortcuts" />
    </Feature>
  </Package>
</Wix>
